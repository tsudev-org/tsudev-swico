---
import TaiLieu from '../components/TaiLieu.astro';
import { docTep, renderMd } from '../lib/noi-dung';
const giayPhep = docTep('LICENSE');
const notice = docTep('NOTICE');
const benThuBa = renderMd('THIRD-PARTY-NOTICES.md', { boTieuDeDau: true, haCap: 1 });
---
<TaiLieu tieuDe="Bản quyền" moTa="Bản quyền và giấy phép của tsudev SWICO: giấy phép Apache 2.0 nguyên văn, tệp NOTICE và danh sách thành phần bên thứ ba kèm giấy phép của từng thành phần." duongDan="/ban-quyen/">
  <h1>Bản quyền</h1>
  <p>tsudev SWICO là phần mềm mã nguồn mở của tsudev, phát hành theo giấy phép Apache 2.0. Bạn được dùng, sửa, phân phối, kể cả cho mục đích thương mại, miễn là giữ thông báo bản quyền, tệp NOTICE và ghi rõ phần đã sửa. Khi có khác biệt, bản tiếng Anh dưới đây có giá trị.</p>

  <h2 id="notice">NOTICE</h2>
  <pre class="giay-phep" tabindex="0" lang="en">{notice}</pre>

  <h2 id="thanh-phan-ben-thu-ba">Thành phần bên thứ ba</h2>
  <Fragment set:html={benThuBa.html} />

  <h2 id="giay-phep-apache-2-0">Giấy phép Apache 2.0 (nguyên văn)</h2>
  <pre class="giay-phep" tabindex="0" lang="en">{giayPhep}</pre>
</TaiLieu>
