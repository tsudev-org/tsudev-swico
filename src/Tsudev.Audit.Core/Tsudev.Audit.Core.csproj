<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net8.0 THUAN, KHONG phu thuoc Windows.
         Toan bo logic nghiep vu nam o day va unit-test duoc tren moi nen tang.
         Bat ky lenh goi he thong nao lot vao day deu la LOI KIEN TRUC -
         phai di qua interface trong Abstractions/. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Tsudev.Audit.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bo luat phat hien duoc NHUNG vao assembly de cong cu chay duoc ngay ca
         khi chi copy moi mot file exe. File ben ngoai (neu co) chi de GHI DE. -->
    <EmbeddedResource Include="Rules/detection-rules.json"
                      LogicalName="Tsudev.Audit.Core.Rules.detection-rules.json" />

    <!-- Token giao dien duoc NHUNG vao assembly vi cung mot ly do: bao cao HTML
         phai xem duoc khi copy sang may khac ma khong keo theo file phu nao.
         .standards/tokens/design-tokens.json la NGUON CHAN LY DUY NHAT cua ca he
         sinh thai (dong bo tu tsudev-standards, KHONG sua tay) - nang bo quy uoc
         la bao cao doi theo, khong phai sua trong ma. QU-STD-1, 09/11/2026. -->
    <EmbeddedResource Include="../../.standards/tokens/design-tokens.json"
                      LogicalName="Tsudev.Audit.Core.Rendering.design-tokens.json" />
  </ItemGroup>
</Project>
